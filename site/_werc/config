fn site_sidebar_link {
    active=''
    if(~ $req_path $1) {
        active=' aria-current="page"'
    }
    if not if(! ~ $1 / && ~ $req_path $1^*) {
        active=' aria-current="location"'
    }
    echo '<a href="'$1'"'$active'>'$2'</a>'
}
